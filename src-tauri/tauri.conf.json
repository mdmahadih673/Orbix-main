{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Orbix",
  "version": "0.1.1",
  "identifier": "com.orbix.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Orbix",
        "width": 1920,
        "height": 520,
        "x": 0,
        "y": 0,
        "decorations": false,
        "transparent": true,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "closable": false,
        "alwaysOnTop": true,
        "visibleOnAllWorkspaces": true,
        "focus": false,
        "skipTaskbar": true,
        "shadow": false,
        "visible": true,
        "dragDropEnabled": true
      },
      {
        "label": "settings",
        "title": "Orbix Settings",
        "url": "settings.html",
        "width": 620,
        "height": 480,
        "decorations": false,
        "transparent": true,
        "resizable": true,
        "maximizable": false,
        "minimizable": false,
        "closable": false,
        "alwaysOnTop": false,
        "visibleOnAllWorkspaces": false,
        "focus": true,
        "skipTaskbar": false,
        "shadow": true,
        "visible": false,
        "center": true
      },
      {
        "label": "overlay",
        "title": "Orbix Overlay",
        "url": "overlay.html",
        "width": 1920,
        "height": 1080,
        "x": 0,
        "y": 0,
        "decorations": false,
        "transparent": true,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "closable": false,
        "alwaysOnTop": true,
        "visibleOnAllWorkspaces": true,
        "focus": false,
        "skipTaskbar": true,
        "shadow": false,
        "visible": false
      },
      {
        "label": "dock",
        "title": "Orbix Dock",
        "url": "dock.html",
        "width": 1920,
        "height": 600,
        "x": 0,
        "y": 480,
        "decorations": false,
        "transparent": true,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "closable": false,
        "alwaysOnTop": true,
        "visibleOnAllWorkspaces": true,
        "focus": false,
        "skipTaskbar": true,
        "shadow": false,
        "visible": false
      },
      {
        "label": "apps",
        "title": "Apps",
        "url": "apps.html",
        "width": 560,
        "height": 440,
        "decorations": false,
        "transparent": true,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "closable": false,
        "alwaysOnTop": true,
        "visibleOnAllWorkspaces": true,
        "focus": true,
        "skipTaskbar": true,
        "shadow": false,
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: blob:; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self' ipc: http://ipc.localhost https://api.open-meteo.com https://geocoding-api.open-meteo.com https://ipapi.co http://ip-api.com"
    }
  },
  "bundle": {
    "active": true,
    "resources": {
      "resources/explorer-glass/ExplorerBlurMica.dll": "explorer-glass/ExplorerBlurMica.dll",
      "resources/explorer-glass/config.ini": "explorer-glass/config.ini",
      "resources/explorer-glass/ReadMe.txt": "explorer-glass/ReadMe.txt"
    },
    "createUpdaterArtifacts": true,
    "targets": "all",
    "publisher": "Orbix Contributors",
    "copyright": "Copyright © 2026 Orbix Contributors.",
    "category": "Utility",
    "shortDescription": "A notch and dock for Windows",
    "longDescription": "Orbix replaces the Windows taskbar with a dock and adds an animated notch for media, quick controls, and status.",
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "https://github.com/Lukog10/Orbix/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQzQTAzNTlBRUFFODRFMDUKUldRRlR1anFtaldnUThWRExWQ2ZDVmxhNGlFREFPYWZoV1BWbGdQNUxxdHpnbzZPbGh4SWxVMk0K"
    }
  }
}
